{
  "name": "gradex-bitm",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:convex": "convex dev",
    "dev:all": "concurrently \"npm run dev:convex\" \"npm run dev\"",
    "build": "vite build",
    "test": "vitest run",
    "deploy:convex": "node scripts/deploy-convex.mjs",
    "preview": "vite preview",
    "app:android": "cap sync android && cd android && ./gradlew assembleRelease",
    "app:android:usb": "npm run app:android && adb install -r android/app/build/outputs/apk/release/app-release.apk"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.4",
    "@vercel/analytics": "^1.5.0",
    "convex": "^1.34.1",
    "html2canvas": "^1.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.2",
    "recharts": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@edge-runtime/vm": "^5.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^8.2.2",
    "convex-test": "^0.0.61",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.9"
  }
}
